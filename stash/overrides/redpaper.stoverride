# Original module authors: RuCu6, fmz200.
# Source: QingRex/LoonKissSurge, revision 913ec005f544221e6c56a7d0ecec81c4b3b914bb.
# Modified by AdsKiller on 2026-10-26: Stash syntax; tiny GIF response embedded.
# Remote script is unmodified; downloaded with the full Loon User-Agent and verified HTTP 200.
# Source and distribution notes: ../../THIRD_PARTY_NOTICES.md
name: '小红书去广告'
desc: '过滤信息流推广，移除图片及视频水印，如有异常，请先清除缓存再尝试。'
author: 'RuCu6[https://github.com/RuCu6], fmz200[https://github.com/fmz200]'
homepage: 'https://hub.kelee.one'
icon: 'https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/RedPaper.png'
openUrl: 'https://apps.apple.com/app/id741292507'
category: 'iKeLee'
version: '2026.10.26'
rules:
  - 'AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,xiaohongshu.com)),REJECT'
http:
  mitm:
    - 'ci.xiaohongshu.com'
    - 'edith.xiaohongshu.com'
    - 'rec.xiaohongshu.com'
    - 'so.xiaohongshu.com'
    - 'www.xiaohongshu.com'
  body-rewrite:
    - '^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/search\/banner_list$ response-jq if (getpath([]) | has("data")) then (setpath(["data"]; {})) else . end'
    - '^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/search\/hot_list$ response-jq if (getpath(["data"]) | has("items")) then (setpath(["data","items"]; [])) else . end'
    - '^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v4\/search\/hint response-jq if (getpath(["data"]) | has("hint_words")) then (setpath(["data","hint_words"]; [])) else . end'
    - '^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v4\/search\/trending\? response-jq if (getpath(["data"]) | has("queries")) then (setpath(["data","queries"]; [])) else . end'
    - '^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v4\/search\/trending\? response-jq if (getpath(["data"]) | has("hint_word")) then (setpath(["data","hint_word"]; {})) else . end'
  mock:
    - match: '^https:\/\/ci\.xiaohongshu\.com\/system_config\/watermark'
      status-code: 200
      headers:
        Content-Type: 'image/gif'
      base64: 'R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7'
    - match: '^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/surprisebox\/(?:get_style|open|submit_action)'
      status-code: 200
      headers:
        Content-Type: 'application/json'
      text: '{}'
    - match: '^https:\/\/www\.xiaohongshu\.com\/api\/marketing\/box\/trigger\?'
      status-code: 200
      headers:
        Content-Type: 'application/json'
      text: '{}'
    - match: '^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/(?:v2\/guide\/user_banner|v3\/note\/guide)'
      status-code: 200
      headers:
        Content-Type: 'application/json'
      text: '{}'
    - match: '^https:\/\/www\.xiaohongshu\.com\/api\/sns\/(?:v1\/ads\/resource|v2\/hey\/\w+\/hey_gallery)'
      status-code: 200
      headers:
        Content-Type: 'application/json'
      text: '{}'
  script:
    - name: 'redpaper-remove-ads'
      match: '^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/note\/(?:imagefeed|live_photo\/save)'
      type: 'response'
      require-body: true
      max-size: 1048576
      timeout: 10
    - name: 'redpaper-remove-ads'
      match: '^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/system\/service\/ui\/config\?'
      type: 'response'
      require-body: true
      max-size: 1048576
      timeout: 10
    - name: 'redpaper-remove-ads'
      match: '^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/system_service\/config\?'
      type: 'response'
      require-body: true
      max-size: 1048576
      timeout: 10
    - name: 'redpaper-remove-ads'
      match: '^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v2\/system_service\/splash_config'
      type: 'response'
      require-body: true
      max-size: 1048576
      timeout: 10
    - name: 'redpaper-remove-ads'
      match: '^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v2\/(?:note\/widgets|user\/followings\/followfeed)'
      type: 'response'
      require-body: true
      max-size: 1048576
      timeout: 10
    - name: 'redpaper-remove-ads'
      match: '^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v4\/followfeed\?'
      type: 'response'
      require-body: true
      max-size: 1048576
      timeout: 10
    - name: 'redpaper-remove-ads'
      match: '^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v5\/recommend\/user\/follow_recommend\?'
      type: 'response'
      require-body: true
      max-size: 1048576
      timeout: 10
    - name: 'redpaper-remove-ads'
      match: '^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/(?:v1\/interaction\/comment\/video\/download|v5\/note\/comment\/list)'
      type: 'response'
      require-body: true
      max-size: 1048576
      timeout: 10
    - name: 'redpaper-remove-ads'
      match: '^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/(?:v2\/note\/feed|v3\/note\/videofeed)'
      type: 'response'
      require-body: true
      max-size: 1048576
      timeout: 10
    - name: 'redpaper-remove-ads'
      match: '^https:\/\/(?:edith|rec)\.xiaohongshu\.com\/api\/sns\/v6\/homefeed\?'
      type: 'response'
      require-body: true
      max-size: 1048576
      timeout: 10
    - name: 'redpaper-remove-ads'
      match: '^https:\/\/(?:edith|so)\.xiaohongshu\.com\/api\/sns\/v10\/search\/notes\?'
      type: 'response'
      require-body: true
      max-size: 1048576
      timeout: 10
    - name: 'redpaper-remove-ads'
      match: '^https:\/\/(?:edith|rec|www)\.xiaohongshu\.com\/api\/sns\/(?:v4\/note\/videofeed|v10\/note\/video\/save)'
      type: 'response'
      require-body: true
      max-size: 1048576
      timeout: 10
script-providers:
  redpaper-remove-ads:
    url: 'https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js'
    interval: 86400
    headers:
      User-Agent: 'Loon/921 CFNetwork/3860.500.111.2.2 Darwin/25.5.0'
